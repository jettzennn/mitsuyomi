# Salin file ini menjadi .env lalu sesuaikan bila perlu.
# Port server Mitsuyomi
PORT=3000
# Alamat dasar layanan data komik (kosongkan untuk memakai bawaan server)
UPSTREAM_BASE=

# --- Akun & email (Gmail SMTP) ---
# Alamat publik situs untuk tautan di email (kosongkan untuk memakai host saat itu)
APP_BASE_URL=
# Akun Gmail pengirim + App Password (buat di Google Account > Security > App passwords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Nama pengirim yang tampil di email
MAIL_FROM_NAME=Mitsuyomi
# 1 = tampilkan tautan aktivasi/reset di layar bila email tidak terkirim
# (mode uji lokal saat SMTP belum disambungkan). Isi 0 untuk produksi.
AUTH_SHOW_DEV_LINK=1
